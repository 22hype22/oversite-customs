# Oversite Customs bot — VPS environment.
# Copy this file to  deploy/.env  and fill in the three secrets.
# Get them from Railway → your bot service → Variables tab (copy the values).

# Discord bot token (Railway var DISCORD_TOKEN, or Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Bot identity — copy these exactly from Railway → Variables
BOT_ORDER_ID=
WORKER_TOKEN=

# IPv6 /64 block to rotate across. Leave BLANK to auto-detect the server's /64
# (works out of the box on Hetzner Cloud). Only set this if auto-detect fails,
# e.g. IPV6_SUBNET=2a01:4f8:1c1e:abcd::/64
IPV6_SUBNET=

# --- Optional (usually NOT needed once IPv6 rotation works) ---
# Leave these blank. They only matter if you're NOT using IPv6 rotation.
# YTDLP_PROXY=
# BGUTIL_POT_BASE_URL=
